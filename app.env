APP_ID="org.outershell.Files"
APP_NAME="Files"
APP_STAGE_NAME="Files"
XCODE_PROJECT="Files.xcodeproj"
XCODE_SCHEME="Files"
XCODE_PRODUCT_NAME="Files"
BUNDLE_ARCHIVE_SCRIPT="Scripts/archive_files_bundle.sh"
BUNDLE_ARCHIVE_STEM="FilesContent.bundle"
BACKEND_SOURCE="Backend/main.c"
BACKEND_EXECUTABLE_NAME="FilesBackend"
BACKEND_CFLAGS="-std=gnu17 -Os -ffunction-sections -fdata-sections -flto"
BACKEND_LDFLAGS="-ldl -lpthread -lm"
DEFAULT_DEPLOY_SCOPE="user"
ROOT_ONLY="false"
